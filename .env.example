# BusWise AI Environment Configuration Placeholder
# Backend URL (Frontend configuration)
VITE_API_BASE_URL=http://localhost:8000

# Supabase Credentials (Optional for local demo mode; Required for Supabase persistence)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here-never-expose-to-frontend

# Application Environment
ENVIRONMENT=development
PORT=8000

# OpenRouteService Configuration (Secret backend API key from https://openrouteservice.org)
# NEVER expose this key in frontend code or commit secrets to Git.
OPENROUTESERVICE_API_KEY=your-openrouteservice-api-key-here

# Traccar Live GPS Tracking Server Configuration (Secret backend credentials)
# Base URL of your Traccar instance (e.g. http://localhost:8082 or https://demo.traccar.org)
TRACCAR_BASE_URL=http://localhost:8082
TRACCAR_USER=admin
TRACCAR_PASSWORD=admin
# Alternatively, Traccar user API Token:
TRACCAR_API_KEY=
# Optional mapping of Traccar device ID or Unique ID to BusWise Bus ID in JSON format
TRACCAR_DEVICE_MAP={"1":"BUS-001","2":"BUS-002","3":"BUS-003"}
